# Only the isolated local Compose service. These are disposable local credentials.
DATABASE_URL=postgresql://celitrip:celitrip_local_only@127.0.0.1:55432/celitrip_dev
CELITRIP_MODE=local-fixtures
NEXT_TELEMETRY_DISABLED=1
CELITRIP_LOCAL_DEMO_PASSWORD_ONLY=0
# Run npm.cmd run auth:configure to generate BETTER_AUTH_SECRET in ignored .env.local.
# Optional server-side machine translation (never needed for Wikidata geographic names).
# DeepL setup/live verification is deferred by the owner. Leave the provider empty.
CELITRIP_TRANSLATION_PROVIDER=
CELITRIP_DEEPL_PLAN=free
