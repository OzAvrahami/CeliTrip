{
  "name": "celitrip",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "db:start": "docker compose up -d --wait",
    "db:stop": "docker compose stop",
    "db:migrate": "node --env-file=.env.local scripts/migrate.js",
    "db:seed": "node --env-file=.env.local scripts/seed.js",
    "test": "node --env-file=.env.local --test tests/*.test.js",
    "lint": "eslint .",
    "version:check": "node scripts/sync-prototype-version.cjs --check && node scripts/check-version.js"
  },
  "dependencies": {
    "next": "16.3.8",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "node-pg-migrate": "9.0.0"
  }
}
